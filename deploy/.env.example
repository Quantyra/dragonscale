# Copy this file to a private .env on the deployment host.
# Do not commit populated secrets.

DRAGONSCALE_HOSTNAME=dragonscale.example.com
DRAGONSCALE_SERVER_URL=https://dragonscale.example.com
DRAGONSCALE_IMAGE=headscale/headscale:v0.28.0

DRAGONSCALE_OIDC_CLIENT_ID=replace-with-google-oauth-client-id
DRAGONSCALE_OIDC_CLIENT_SECRET=replace-with-google-oauth-client-secret

DRAGONSCALE_ALLOWED_USER_1=admin@example.com
DRAGONSCALE_ALLOWED_USER_2=operator@example.com

DRAGONSCALE_DATA_DIR=/opt/dragonscale/data
DRAGONSCALE_CONFIG_DIR=/opt/dragonscale/config
